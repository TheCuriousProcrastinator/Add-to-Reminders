{
  "manifest_version": 3,
  "name": "Add Website to Reminders",
  "version": "0.1.1",
  "description": "Add the current website to Apple Reminders.",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging",
    "contextMenus"
  ],
  "action": {
    "default_title": "Add to Reminders",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "mac": "Alt+Shift+R"
      },
      "description": "Add current website to Reminders"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
